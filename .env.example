# Custos application environment variables
# Copy to .env for local development. Never commit .env.

# Generation provider: anthropic (default) or bedrock.
CUSTOS_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-PLACEHOLDER
# CUSTOS_MODEL=claude-sonnet-4-6

# Bedrock uses the AWS credential chain; no model API key is passed.
# CUSTOS_BEDROCK_REGION=us-east-1
# AWS_REGION=us-east-1
# CUSTOS_BEDROCK_MODEL=us.anthropic.claude-sonnet-4-6

# Agent runtime: native (default) or langgraph.
CUSTOS_AGENT_RUNTIME=native

# Vector store: qdrant (default) or pgvector.
CUSTOS_VECTOR_BACKEND=qdrant
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=custos
# CUSTOS_PGVECTOR_DSN=postgresql://user:password@localhost:5432/custos

# Corpus and local state.
# CUSTOS_CORPUS_DIR=corpus/output
CUSTOS_DATA_DIR=data

# API boundary configuration.
CUSTOS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set only behind a trusted proxy that overwrites X-Forwarded-For.
CUSTOS_TRUST_PROXY=false
# If unset, /api/admin/status fails closed and always returns 404.
# CUSTOS_ADMIN_TOKEN=replace-with-a-long-random-token

# Abuse and budget controls.
CUSTOS_DAILY_CAP=150
CUSTOS_MONTHLY_CAP=4000
CUSTOS_SESSION_QUOTA=25
CUSTOS_RATE_PER_MIN=8
CUSTOS_MAX_QUERY_LEN=500
# Optional text appended to quota messages.
# CUSTOS_CONTACT_LINE=contact Andrew for extended access
