# make demo's background process state (PIDs, logs) -- regenerated every run
.demo/

# Terraform. State holds resource IDs and, often, plaintext attribute values,
# so it must never be committed. Plan caches are machine specific, and a real
# tfvars belongs to whoever runs the deploy, not to the repo. The provider lock
# file IS committed on purpose: it pins the exact provider versions so every
# operator resolves the same ones.
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
*.tfvars
!*.tfvars.example
crash.log
*.tfplan
